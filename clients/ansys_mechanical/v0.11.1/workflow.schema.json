{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "analysis_name",
    "support_name",
    "support_face_ids",
    "force_name",
    "mesh_element_size_mm",
    "output_directory",
    "human_confirmation"
  ],
  "properties": {
    "project": {
      "type": "string",
      "description": "Existing standalone .mechdat with confirmed geometry and material assignments"
    },
    "analysis_name": {
      "type": "string"
    },
    "support_name": {
      "type": "string"
    },
    "support_face_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "force_name": {
      "type": "string"
    },
    "force_face_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "force_N": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      },
      "description": "Global Fx, Fy, Fz in N"
    },
    "mesh_element_size_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "human_confirmation": {
      "type": "boolean",
      "description": "Must be true only after the operator manually verifies material, selected faces, load direction, units, and confirms the solve."
    },
    "output_directory": {
      "type": "string",
      "description": "New output directory that does not exist"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_displacement_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "acceptance_source": {
          "type": "string",
          "minLength": 1
        },
        "mesh_convergence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relative_tolerance",
            "threshold_source",
            "refinement_factor",
            "max_levels",
            "max_elements"
          ],
          "properties": {
            "relative_tolerance": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "threshold_source": {
              "type": "string",
              "minLength": 1
            },
            "refinement_factor": {
              "type": "number",
              "minimum": 0.4,
              "maximum": 0.9
            },
            "max_levels": {
              "type": "integer",
              "minimum": 2,
              "maximum": 4
            },
            "max_elements": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            }
          }
        }
      }
    },
    "load": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "force_N",
            "entity_ids"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "force"
            },
            "force_N": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "entity_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "pressure_Pa",
            "entity_ids"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "pressure"
            },
            "pressure_Pa": {
              "type": "number"
            },
            "entity_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "moment_Nmm",
            "entity_ids"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "moment"
            },
            "moment_Nmm": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "entity_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "gravity_m_s2"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "gravity"
            },
            "gravity_m_s2": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "force_N",
            "entity_ids",
            "application_point_mm"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "remote_force"
            },
            "force_N": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "entity_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "application_point_mm": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "behavior": {
              "enum": [
                "deformable",
                "rigid"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "force_N",
            "entity_ids"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "point_force"
            },
            "force_N": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "entity_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "line_force_N_per_mm",
            "entity_ids"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "line_force"
            },
            "line_force_N_per_mm": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "entity_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    {
      "required": [
        "load"
      ]
    },
    {
      "required": [
        "force_N",
        "force_face_ids"
      ]
    }
  ]
}