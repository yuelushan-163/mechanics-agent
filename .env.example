# API
APP_HOST=127.0.0.1
APP_PORT=8000

# Backend monitoring. Passive checks never call paid models.
MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=30
MONITORING_TIMEOUT_SECONDS=5
STARTUP_TIMEOUT_SECONDS=10

# Elasticsearch
ES_URL=http://127.0.0.1:9200
ES_INDEX_PREFIX=mechanics-agent
ES_API_KEY=
ES_USERNAME=
ES_PASSWORD=
ES_VERIFY_CERTS=true
ES_VECTOR_DIMS=1024
ES_REQUEST_TIMEOUT_SECONDS=5

# MongoDB operational data: users, projects, tasks, approvals and error logs.
# Password should be supplied through a Docker Secret in production.
MONGO_URL=
MONGO_APP_DATABASE=mechanics_agent
MONGO_APP_USERNAME=
MONGO_APP_PASSWORD=
MONGO_REQUEST_TIMEOUT_SECONDS=5

# Planner modes: siliconflow, kimi, local, or auto.
# auto keeps Kimi compatibility first, then SiliconFlow, then the local fallback.
PLANNER_MODE=auto

# SiliconFlow. Set PLANNER_MODE=siliconflow for the first DeepSeek test.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Leave blank to omit this model-specific parameter on the first test.
SILICONFLOW_ENABLE_THINKING=
SILICONFLOW_MAX_TOKENS=8192

# Kimi
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
KIMI_THINKING_ENABLED=true
KIMI_MAX_TOKENS=16000

# Optional OpenAI-compatible embeddings endpoint.
# Use the same embedding model and dimension for ingestion and querying.
# SiliconFlow Qwen3-Embedding-0.6B returns 1024 dimensions by default.
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMS=1024
EMBEDDING_SEND_DIMENSIONS=true

# Model pricing in CNY per 1,000 tokens.
# Defaults below come from the user-provided SiliconFlow screenshots dated 2026-07-31.
# Pricing is matched to the exact model ID; changing a model without updating its
# pricing model ID records tokens but marks pricing as missing instead of misbilling.
SILICONFLOW_PRICING_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_CACHED_INPUT_PRICE_PER_K=0.000020
SILICONFLOW_INPUT_PRICE_PER_K=0.001000
SILICONFLOW_OUTPUT_PRICE_PER_K=0.002000
EMBEDDING_PRICING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_INPUT_PRICE_PER_K=0.000070
